[Unit]
Description=revlev.ru feedback (file + Cloudflare Worker)
After=network.target

[Service]
Type=simple
User=www-data
Group=www-data
WorkingDirectory=/opt/revlev/feedback-vps
EnvironmentFile=/opt/revlev/feedback-vps/.env
ExecStart=/opt/revlev/feedback-vps/.venv/bin/uvicorn app.main:app --host 127.0.0.1 --port 8001
Restart=on-failure
RestartSec=3

NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
